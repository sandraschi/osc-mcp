{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "maintainers": ["sandraschi"],
  "name": "osc-mcp",
  "description": "FastMCP 2.13 Open Sound Control MCP server for audio/visual automation. Control of Ableton Live, TouchDesigner, VRChat, Max/MSP, and other OSC-enabled applications. Beta status.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 2.13",
  "tools": 6,
  "transport": ["stdio", "http"],
  "keywords": [
    "osc",
    "open-sound-control",
    "audio",
    "daw",
    "ableton",
    "vrchat",
    "touchdesigner",
    "mcp-server",
    "fastmcp",
    "automation"
  ],
  "features": {
    "bidirectional": {
      "enabled": true,
      "note": "Send and receive OSC messages"
    },
    "response_caching": {
      "enabled": true,
      "ttl": 60
    },
    "applications": {
      "enabled": true,
      "supported": ["Ableton Live", "TouchDesigner", "VRChat", "Max/MSP", "SuperCollider", "Pure Data"]
    }
  }
}

