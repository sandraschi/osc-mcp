# OSC-MCP Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the actual .env file.

# OSC Server Configuration
OSC_MCP_HOST=127.0.0.1
OSC_MCP_PORT=10767

# LLM Provider (optional, defaults to Ollama)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://localhost:11434

# OBS WebSocket Bridge
# OBS_WS_HOST=127.0.0.1
# OBS_WS_PORT=4455
# OBS_WS_PASSWORD=

# MIDI Configuration
# MIDI_DEFAULT_INPUT=
# MIDI_DEFAULT_OUTPUT=

# OSC Applications
# ABLETON_OSC_PORT=11000
# TOUCHDESIGNER_OSC_PORT=12000
# MAXMSP_OSC_PORT=13000
# SUPERCOLLIDER_OSC_PORT=57120
# VCV_RACK_OSC_PORT=14000
