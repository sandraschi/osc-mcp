{
  "manifest_version": "0.3",
  "name": "osc-mcp",
  "version": "0.3.0",
  "description": "FastMCP 2.14.3 OSC Server with conversational AI and LLM sampling for audio/visual automation",
  "author": {
    "name": "Sandra",
    "email": "dev@osc-mcp.example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/osc-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandraschi/osc-mcp"
  },
  "server": {
    "type": "fastmcp",
    "entry_point": "oscmcp.server:server",
    "capabilities": ["conversational_tools", "llm_sampling", "osc_automation"],
    "fastmcp_config": {
      "transport": "stdio",
      "sampling_enabled": true,
      "conversational_returns": true
    }
  },
  "user_config": {
    "default_host": {
      "type": "string",
      "title": "Default OSC Host",
      "description": "Default IP address for OSC message sending",
      "required": false,
      "default": "127.0.0.1"
    },
    "default_port": {
      "type": "integer",
      "title": "Default OSC Port",
      "description": "Default UDP port for OSC communication",
      "required": false,
      "default": 8000,
      "min": 1024,
      "max": 65535
    },
    "sampling_provider": {
      "type": "string",
      "title": "LLM Sampling Provider",
      "description": "LLM provider for workflow generation (anthropic/openai/auto)",
      "required": false,
      "default": "auto",
      "enum": ["anthropic", "openai", "auto"]
    }
  },
  "tools": [
    {
      "name": "send_osc_message",
      "description": "Send OSC messages with AI validation and conversational guidance",
      "capabilities": ["conversational", "validation"]
    },
    {
      "name": "start_osc_listener",
      "description": "Start OSC listeners with intelligent monitoring",
      "capabilities": ["monitoring", "conversational"]
    },
    {
      "name": "generate_osc_workflow",
      "description": "Generate complex OSC workflows using LLM sampling",
      "capabilities": ["llm_sampling", "conversational", "ai_generation"]
    },
    {
      "name": "execute_osc_workflow",
      "description": "Execute AI-generated OSC workflows with validation",
      "capabilities": ["execution", "validation", "conversational"]
    },
    {
      "name": "test_osc_echo",
      "description": "Test OSC connectivity with comprehensive analysis",
      "capabilities": ["testing", "conversational", "analysis"]
    }
  ],
  "features": {
    "conversational_tools": true,
    "llm_sampling": true,
    "osc_automation": true,
    "real_time_monitoring": true,
    "workflow_generation": true
  },
  "compatibility": {
    "platforms": ["win32", "darwin", "linux"],
    "python": ">=3.8",
    "fastmcp": ">=2.14.3,<3.0.0"
  },
  "keywords": [
    "osc",
    "mcp",
    "automation",
    "audio",
    "visual",
    "fastmcp",
    "conversational-ai",
    "llm-sampling",
    "real-time",
    "udp",
    "music-production",
    "live-performance",
    "vj",
    "dmx",
    "midi"
  ]
}

